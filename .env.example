NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Used by the photo cleanup job (src/app/api/cron/cleanup-images).
SUPABASE_SECRET_KEY=your-secret-key
# Any long random string; the cleanup endpoint refuses to run without it.
CRON_SECRET=generate-with-openssl-rand-hex-32
# Set to 1 once the Google provider is enabled in Supabase Auth, to show the "Sign in with Google" button.
NEXT_PUBLIC_GOOGLE_LOGIN=
# Web Push (generate with: npx web-push generate-vapid-keys). Without them the notification toggle is hidden.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@lrp.ac.th
# Nightly backup to Google Drive (see docs/backup.md).
BACKUP_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
